#!/usr/bin/env python3

import re
import sys
from pathlib import Path


def flush_movetext(movetext):
    if movetext:
        print(re.sub(r"\s+", " ", " ".join(movetext)).strip())
        print()
        movetext.clear()


def main():
    if len(sys.argv) != 2:
        print("usage: flatten-pgn <file>", file=sys.stderr)
        return 2

    movetext = []
    for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
        if line.startswith("["):
            flush_movetext(movetext)
            print(line)
        elif line.strip():
            movetext.append(line)

    flush_movetext(movetext)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
